# 代理鉴权密钥（必填，服务端读取，永不回传客户端）
PROXY_API_KEY=
# 搜索 / 抓取供应商密钥（Tinyfish，八家任一非空即可启动）
TINYFISH_API_KEY=
# 搜索 / 抓取供应商密钥（Tavily，八家任一非空即可启动）
TAVILY_API_KEY=
# 搜索 / 抓取供应商密钥（Exa，八家任一非空即可启动）
EXA_API_KEY=
# 搜索供应商密钥（Querit，八家任一非空即可启动）
QUERIT_API_KEY=
# 搜索 / 抓取供应商密钥（HasData，八家任一非空即可启动）
HASDATA_API_KEY=
# 搜索 / 抓取供应商密钥（Firecrawl，八家任一非空即可启动）
FIRECRAWL_API_KEY=
# 抓取供应商密钥（Scrape.do，八家任一非空即可启动）
SCRAPEDO_API_KEY=
# 抓取供应商密钥（ScraperAPI，八家任一非空即可启动）
SCRAPERAPI_API_KEY=
# 默认搜索供应商（默认 tinyfish，单源语义保留）
SEARCH_PROVIDER=tinyfish
# 默认抓取主供应商（默认 tinyfish，主备语义保留）
FETCH_PRIMARY=tinyfish
# 默认抓取兜底供应商（默认 tavily，主备语义保留）
FETCH_FALLBACK=tavily
# 搜索扇出名单（逗号分隔，默认 tinyfish,tavily）
SEARCH_PROVIDERS=tinyfish,tavily
# 抓取分级名单（逗号分隔，默认 tinyfish，上限 5 级防烧钱）
FETCH_CHAIN=tinyfish
# 验证搜索名单（逗号分隔，默认 tinyfish,tavily）
VERIFY_SEARCH_PROVIDERS=tinyfish,tavily
# 验证抓取名单（逗号分隔，默认 tinyfish,tavily）
VERIFY_FETCH_CHAIN=tinyfish,tavily
# 余额查询超时毫秒数（默认 15000）
CREDITS_TIMEOUT_MS=15000
